// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int          @id @default(autoincrement())
  firstName  String
  lastName   String
  userId     String       @unique
  username   String?      @default("null")
  enabled    Boolean?     @default(true)
  shares     Shares[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  userEmails UserEmails[]
}

model UserEmails {
  id           Int    @id @default(autoincrement())
  emailId      String @unique
  emailAddress String
  userId       String
  user         User   @relation(fields: [userId], references: [userId])
}

model Shares {
  id           Int            @id @default(autoincrement())
  user         User           @relation(fields: [userId], references: [id])
  userId       Int
  isDue        Boolean        @default(false)
  endDate      DateTime?      @db.Date
  needCode     Boolean        @default(false)
  codeAccess   String?        @default("null")
  oneView      Boolean        @default(false)
  sharesData   SharesData[]
  sharesEmails SharesEmails[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model SharesData {
  id        Int      @id @default(autoincrement())
  sharesId  Int
  shares    Shares   @relation(fields: [sharesId], references: [id])
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SharesEmails {
  id       Int     @id @default(autoincrement())
  email    String
  sharesId Int
  shares   Shares  @relation(fields: [sharesId], references: [id])
  isView   Boolean @default(false)
}
